rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /leaderboard/{uid} {
      // Public leaderboard rows: only the signed-in owner can create or update their own row.
      // This validates data shape, but does NOT prove that the submitted score was earned fairly.
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll([
          'uid', 'displayName', 'email', 'points', 'level',
          'correct', 'wrong', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'email', 'points', 'level',
          'correct', 'wrong', 'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.points is number
        && request.resource.data.points >= -1000000
        && request.resource.data.points <= 100000000
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.level <= 1000000
        && request.resource.data.correct is int
        && request.resource.data.correct >= 0
        && request.resource.data.correct <= 100000000
        && request.resource.data.wrong is int
        && request.resource.data.wrong >= 0
        && request.resource.data.wrong <= 100000000
        && request.resource.data.updatedAt is timestamp;
      // Updates are monotonic. Exact point-delta matching was removed because older
      // installs may have legacy totals that do not reconcile with answer counters.
      // This prevents score rollback, but client-submitted scores are not cheat-proof.
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll([
          'uid', 'displayName', 'email', 'points', 'level',
          'correct', 'wrong', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'email', 'points', 'level',
          'correct', 'wrong', 'updatedAt'
        ])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.points is number
        && request.resource.data.points >= resource.data.points
        && request.resource.data.points <= 100000000
        && request.resource.data.level is int
        && request.resource.data.level >= resource.data.level
        && request.resource.data.level <= 1000000
        && request.resource.data.correct is int
        && request.resource.data.correct >= resource.data.correct
        && request.resource.data.correct <= 100000000
        && request.resource.data.wrong is int
        && request.resource.data.wrong >= resource.data.wrong
        && request.resource.data.wrong <= 100000000
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.updatedAt is timestamp;
      // A client must not be able to erase leaderboard history.
      allow delete: if false;
    }

    match /publicQuestionBank/{documentId} {
      // Everyone can read published quiz questions. Only the configured owner UID can publish.
      // Replace the placeholder with the owner's Firebase Authentication UID before publishing.
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && request.auth.uid == 'TIEU9BdlVFcj2LzwoGKI2BOd2tR2';
    }

    match /appPresence/{uid} {
      // Players may write only their own heartbeat; only the app owner may read all presence.
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'lastSeen'])
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.lastSeen is timestamp;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null
        && request.auth.uid == 'TIEU9BdlVFcj2LzwoGKI2BOd2tR2';
    }

    match /users/{uid} {
      // A signed-in user may access only their own private profile document.
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Private question-bank backup; no user can read or modify another user's bank.
      match /questionBank/{documentId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
