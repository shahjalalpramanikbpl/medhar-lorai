rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /leaderboard/{uid} {
      // Public leaderboard rows: only the signed-in owner can create or update their own row.
      // This validates data shape, but does NOT prove that the submitted score was earned fairly.
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll([
          'uid', 'displayName', 'email', 'points', 'level',
          'correct', 'wrong', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'email', 'points', 'level',
          'correct', 'wrong', 'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.points is number
        && request.resource.data.points >= -1000000
        && request.resource.data.points <= 100000000
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.level <= 1000000
        && request.resource.data.correct is int
        && request.resource.data.correct >= 0
        && request.resource.data.correct <= 100000000
        && request.resource.data.wrong is int
        && request.resource.data.wrong >= 0
        && request.resource.data.wrong <= 100000000
        && request.resource.data.updatedAt is timestamp;
      // A client must not be able to erase leaderboard history.
      allow delete: if false;
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
